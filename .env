# Configuration de l'application
# Copiez ce fichier en .env et remplacez les valeurs par vos propres secrets

# Base de données
DATABASE_URL=sqlite:///./database.sqlite
# Pour PostgreSQL : DATABASE_URL=postgresql://user:password@localhost/dbname
# Pour MySQL : DATABASE_URL=mysql://user:password@localhost/dbname

# Sécurité JWT - IMPORTANT : Changez cette clé en production !
SECRET_KEY=votre-cle-secrete-tres-longue-et-compliquee-a-changer-en-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - Origines autorisées (format JSON)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://localhost:8081","http://localhost:19006","http://192.168.1.12:8081","http://192.168.1.12:19006","http://10.82.29.254:8081","http://192.168.1.27:8081"]

# Rate limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_STANDARD=100/minute
RATE_LIMIT_ADMIN=200/minute
RATE_LIMIT_PUBLIC=50/minute

# Uploads
MAX_AVATAR_SIZE=2097152
ALLOWED_AVATAR_TYPES=["image/jpeg","image/png","image/webp"]

# Environnement
ENVIRONMENT=development
DEBUG=true
